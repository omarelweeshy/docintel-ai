# Local development defaults only. Do not reuse this database password in deployment.
POSTGRES_USER=docintel
POSTGRES_PASSWORD=docintel
POSTGRES_DB=docintel
DATABASE_URL=postgresql+asyncpg://docintel:docintel@localhost:5432/docintel
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
CHAT_MODEL=qwen3.5:4b
EMBEDDING_MODEL=qwen3-embedding:0.6b
EMBEDDING_DIMENSIONS=1024
OLLAMA_NUM_CTX=8192
OPENAI_API_KEY=
STORAGE_DIR=storage
CORS_ORIGINS=["http://localhost:3000"]
NEXT_PUBLIC_API_URL=http://localhost:8000
MAX_UPLOAD_BYTES=20971520
MAX_DOCUMENT_CHARS=2000000
MAX_PAGES=500
# OCR for PDF pages without a text layer (tesseract or none); needs Tesseract installed natively
OCR_ENGINE=tesseract
CHUNK_WORDS=350
CHUNK_OVERLAP=50
MAX_CHUNK_CHARS=6000
MAX_CHUNKS=2000
TOP_K=6
# hybrid = vector + PostgreSQL full-text search fused by reciprocal rank fusion; vector = original
RETRIEVAL_MODE=hybrid
RRF_K=60
CANDIDATE_POOL=30
RETRIEVAL_DEPTH=20
# Cross-encoder reranker on the CPU (none, gte-modernbert, bge-m3, qwen3-0.6b); needs `uv sync --group ml`
RERANKER=none
RERANK_CANDIDATES=20
# Rewrite follow-up questions using recent conversation turns (one extra local model call)
QUERY_PLANNING=false
HISTORY_MESSAGES=6
MIN_SIMILARITY=0.25
MAX_QUESTION_CHARS=2000
MAX_CONTEXT_CHARS=24000
PROVIDER_TIMEOUT_SECONDS=180
